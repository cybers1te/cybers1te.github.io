rules_version = '2';

// Règles de sécurité de message-me.
//
// La clé d'API Firebase présente dans public/firebase-config.js est publique
// par conception : c'est CE fichier qui protège les données. Tout ce qui n'est
// pas explicitement autorisé ici est refusé.
//
// Les messages sont chiffrés de bout en bout dans le navigateur
// (public/e2e.js) : Firestore ne stocke que du texte chiffré.
//
// Modèle de données :
//   usernames/{pseudo}                     -> { uid }          (unicité du pseudo)
//   users/{uid}                            -> { name, username, createdAt, publicKey }
//   keys/{uid}                             -> { v, publicKey, byPassword, byRecovery,
//                                               updatedAt }    (clé privée scellée)
//   settings/{uid}                         -> { blocked, muted }  (privé : personnes
//                                               bloquées, conversations en sourdine)
//   conversations/{cid}                    -> { type, members, title, createdBy,
//                                               createdAt, updatedAt,
//                                               lastMessage, lastRead, typing,
//                                               admins, perms, description } (groupes)
//   conversations/{cid}/messages/{mid}     -> { uid, enc, createdAt }
//                                             (anciens messages : { uid, text, createdAt })
//   conversations/{cid}/media/{mid}        -> { uid, data, createdAt }
//                                             (photo ou vocal chiffré du message {mid})
//   conversations/{cid}/restrictions/{uid} -> { until, by, at }
//                                             (membre d'un groupe privé de parole)
//   calls/{callId}                         -> { cid, caller, callee, video, status,
//                                               offer, answer, createdAt, answeredAt,
//                                               endedAt, endedBy }
//   calls/{callId}/callerCandidates/{id}   -> candidat ICE de l'appelant
//   calls/{callId}/calleeCandidates/{id}   -> candidat ICE de l'appelé
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    // Clé publique P-256 brute (65 octets), en base64.
    function validPublicKey(key) {
      return key is string && key.size() == 88;
    }

    // Clé privée scellée par PBKDF2 + AES-GCM (voir public/e2e.js).
    function validBox(box) {
      return box is map
        && box.keys().hasOnly(['salt', 'iv', 'ct', 'iter'])
        && box.keys().hasAll(['salt', 'iv', 'ct', 'iter'])
        && box.salt is string && box.salt.size() <= 64
        && box.iv is string && box.iv.size() <= 32
        && box.ct is string && box.ct.size() <= 512
        && box.iter is int && box.iter >= 100000 && box.iter <= 10000000;
    }

    // Le compte {uid} a bloqué le compte connecté. Sa liste de blocage
    // (settings/{uid}) n'est lisible que par lui : seules les règles la
    // consultent, pour refuser messages, appels et ajouts à un groupe.
    function blockedBy(uid) {
      return exists(/databases/$(database)/documents/settings/$(uid))
        && me() in get(/databases/$(database)/documents/settings/$(uid)).data.get('blocked', []);
    }

    // ------------------------------------------------------------------
    // Pseudos : un document par pseudo, créé une seule fois, en même temps
    // que le profil. Lisible un par un (pour trouver quelqu'un), jamais listé.
    // ------------------------------------------------------------------
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        // Un seul pseudo par compte : le profil ne doit pas encore exister…
        && !exists(/databases/$(database)/documents/users/$(me()))
        // … et il doit être créé dans la même écriture, avec ce pseudo.
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username == username;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Profils publics : nom affiché et pseudo. Aucune adresse e-mail ici.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'username', 'createdAt', 'publicKey'])
        && validName(request.resource.data.name)
        && request.resource.data.username is string
        && request.resource.data.createdAt == request.time
        && (!('publicKey' in request.resource.data) || validPublicKey(request.resource.data.publicKey))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // Le nom affiché et la clé publique peuvent changer ; le pseudo est
      // définitif. La clé publique suit toujours celle de keys/{uid}.
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'publicKey'])
        && validName(request.resource.data.name)
        && (!('publicKey' in request.resource.data.diff(resource.data).affectedKeys())
          || (validPublicKey(request.resource.data.publicKey)
            && getAfter(/databases/$(database)/documents/keys/$(uid)).data.publicKey
              == request.resource.data.publicKey));
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Clé privée de chaque compte, scellée par son mot de passe et par son
    // code de secours. Seul son propriétaire la lit ; elle est inutilisable
    // sans l'un des deux secrets.
    // ------------------------------------------------------------------
    match /keys/{uid} {
      allow get: if signedIn() && uid == me();
      allow list: if false;
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['v', 'publicKey', 'byPassword', 'byRecovery', 'updatedAt'])
        && request.resource.data.keys().hasAll(['v', 'publicKey', 'byPassword', 'byRecovery', 'updatedAt'])
        && request.resource.data.v == 1
        && validPublicKey(request.resource.data.publicKey)
        && validBox(request.resource.data.byPassword)
        && validBox(request.resource.data.byRecovery)
        && request.resource.data.updatedAt == request.time
        // Le profil public annonce la même clé, après cette écriture.
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.publicKey
          == request.resource.data.publicKey;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Réglages privés de chaque compte : personnes bloquées et
    // conversations en sourdine. Personne d'autre ne les lit.
    // ------------------------------------------------------------------
    match /settings/{uid} {
      allow get: if signedIn() && uid == me();
      allow list: if false;
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['blocked', 'muted'])
        && request.resource.data.get('blocked', []) is list
        && request.resource.data.get('blocked', []).size() <= 500
        && !(me() in request.resource.data.get('blocked', []))
        && request.resource.data.get('muted', {}) is map
        && request.resource.data.get('muted', {}).size() <= 500;
      allow delete: if signedIn() && uid == me();
    }

    // ------------------------------------------------------------------
    // Conversations
    // ------------------------------------------------------------------
    match /conversations/{cid} {

      function isMember(data) {
        return signedIn() && data.members is list && me() in data.members;
      }

      // Rôles d'un groupe. Un groupe créé avant l'arrivée des admins n'a ni
      // `admins` ni `perms` : son créateur en est le seul admin, et chaque
      // membre peut tout faire.
      function adminsOf(d) {
        return d.get('admins', [d.createdBy]);
      }

      function isAdmin(d) {
        return me() in adminsOf(d);
      }

      // what : 'send' (écrire), 'info' (nom et description), 'add' (ajouter
      // des membres). Réglé sur 'all' (tous les membres) ou 'admins'.
      function allowed(d, what) {
        return d.get('perms', {}).get(what, 'all') == 'all' || isAdmin(d);
      }

      function validPerms(p) {
        return p is map
          && p.keys().hasOnly(['send', 'info', 'add'])
          && p.keys().hasAll(['send', 'info', 'add'])
          && p.send in ['all', 'admins']
          && p.info in ['all', 'admins']
          && p.add in ['all', 'admins'];
      }

      function validTitle(t) {
        return t is string && t.size() >= 1 && t.size() <= 60;
      }

      function validDescription(t) {
        return t is string && t.size() <= 300;
      }

      function validCreate() {
        let d = request.resource.data;
        let base = ['type', 'members', 'title', 'createdBy',
                    'createdAt', 'updatedAt', 'lastMessage', 'lastRead'];
        return d.keys().hasAll(base)
          && d.createdBy == me()
          && d.members is list
          && me() in d.members
          && d.createdAt == request.time
          && d.updatedAt == request.time
          && d.lastMessage == null
          && d.lastRead == {}
          && d.title is string
          && (
            // Discussion à deux : identifiant déterministe (dm_<uidA>_<uidB>,
            // uid triés) pour qu'il n'en existe qu'une par paire. Impossible
            // d'en ouvrir une avec quelqu'un qui nous a bloqués.
            (d.type == 'dm'
              && d.keys().hasOnly(base)
              && d.members.size() == 2
              && d.members[0] < d.members[1]
              && cid == 'dm_' + d.members[0] + '_' + d.members[1]
              && d.title == ''
              && !blockedBy(d.members.removeAll([me()])[0]))
            ||
            // Groupe : il naît avec son seul créateur, qui y ajoute ensuite
            // chaque membre un par un (isAddUpdate). Les règles vérifient
            // ainsi qu'aucun membre n'est ajouté par quelqu'un qu'il a bloqué.
            (d.type == 'group'
              && d.keys().hasOnly(base.concat(['admins', 'perms', 'description']))
              && d.members == [me()]
              && d.admins == [me()]
              && validPerms(d.perms)
              && validDescription(d.description)
              && validTitle(d.title))
          );
      }

      // Message chiffré (public/e2e.js) : une clé emballée pour chaque
      // membre, et pour personne d'autre. v1 : texte ; v2 : enveloppe
      // (photo, message vocal, journal d'appel, événement du groupe).
      function validEnc(e, members) {
        return e is map
          && e.keys().hasOnly(['v', 'e', 'iv', 'ct', 'k'])
          && e.keys().hasAll(['v', 'e', 'iv', 'ct', 'k'])
          && e.v in [1, 2]
          && e.e is string && e.e.size() == 88
          && e.iv is string && e.iv.size() == 16
          && e.ct is string && e.ct.size() >= 24 && e.ct.size() <= 8200
          && e.k is map
          && e.k.keys().hasAll(members)
          && e.k.keys().hasOnly(members);
      }

      // Le compte connecté a le droit d'écrire : dans un groupe, s'il n'est
      // pas privé de parole et si l'écriture n'est pas réservée aux admins ;
      // dans une discussion à deux, si l'autre ne l'a pas bloqué.
      function canPost(d) {
        return (d.type == 'group'
            && allowed(d, 'send')
            && !(exists(/databases/$(database)/documents/conversations/$(cid)/restrictions/$(me()))
              && get(/databases/$(database)/documents/conversations/$(cid)/restrictions/$(me())).data.until > request.time))
          || (d.type == 'dm' && !blockedBy(d.members.removeAll([me()])[0]));
      }

      // Le message cité par l'aperçu vient d'être créé par l'auteur, dans
      // cette même écriture groupée, et l'aperçu recopie son texte chiffré.
      function isFreshMessage(lm) {
        let msg = getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(lm.id)).data;
        return msg.uid == me() && msg.createdAt == request.time && msg.enc == lm.enc;
      }

      // Envoi d'un message : l'aperçu est mis à jour dans la même écriture
      // groupée que le message.
      function isPostUpdate() {
        let d = request.resource.data;
        let lm = d.lastMessage;
        return d.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'lastRead'])
          && d.updatedAt == request.time
          && lm is map
          && lm.keys().hasOnly(['id', 'uid', 'enc', 'at'])
          && lm.uid == me()
          && lm.at == request.time
          && lm.id is string
          && isFreshMessage(lm)
          && d.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([me()])
          && d.lastRead[me()] == request.time;
      }

      // Accusé de lecture : chacun ne touche qu'à sa propre date de lecture.
      function isReadUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['lastRead'])
          && d.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([me()])
          && d.lastRead[me()] == request.time;
      }

      // « … écrit » : chacun ne touche qu'à sa propre date de saisie.
      function isTypingUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly(['typing'])
          && d.typing is map
          && d.typing.diff(resource.data.get('typing', {})).affectedKeys().hasOnly([me()])
          && d.typing[me()] == request.time;
      }

      // Nom et description du groupe.
      function isInfoUpdate() {
        let d = request.resource.data;
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['title', 'description'])
          && allowed(resource.data, 'info')
          && validTitle(d.title)
          && validDescription(d.get('description', ''));
      }

      // Qui peut écrire, modifier les infos, ajouter des membres : les admins.
      function isPermsUpdate() {
        let d = request.resource.data;
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['perms'])
          && isAdmin(resource.data)
          && validPerms(d.perms);
      }

      // Ajouter UN membre : un compte qui existe, et qui n'a pas bloqué
      // l'auteur de l'ajout. 20 membres au plus.
      function isAddUpdate() {
        let d = request.resource.data;
        let added = d.members.removeAll(resource.data.members);
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['members'])
          && allowed(resource.data, 'add')
          && d.members.size() == resource.data.members.size() + 1
          && d.members.size() <= 20
          && d.members.hasAll(resource.data.members)
          && added.size() == 1
          && exists(/databases/$(database)/documents/users/$(added[0]))
          && !blockedBy(added[0]);
      }

      // Retirer UN membre : un admin, jamais le propriétaire (créateur) du
      // groupe. S'il était admin, il perd ce rôle en même temps.
      function isRemoveUpdate() {
        let d = request.resource.data;
        let removed = resource.data.members.removeAll(d.members);
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['members', 'admins'])
          && isAdmin(resource.data)
          && removed.size() == 1
          && d.members == resource.data.members.removeAll(removed)
          && removed[0] != me()
          && removed[0] != resource.data.createdBy
          && adminsOf(d) == adminsOf(resource.data).removeAll(removed);
      }

      // Quitter un groupe : on ne peut retirer que soi-même. Le dernier
      // admin qui s'en va passe la main à un membre restant.
      function isLeaveUpdate() {
        let d = request.resource.data;
        let rest = adminsOf(resource.data).removeAll([me()]);
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['members', 'admins'])
          && d.members == resource.data.members.removeAll([me()])
          && ((adminsOf(d) == rest
              && (rest.size() > 0 || !isAdmin(resource.data) || d.members.size() == 0))
            || (rest.size() == 0 && adminsOf(d).size() == 1 && d.members.hasAll(adminsOf(d))));
      }

      // Donner ou retirer les droits d'admin (un admin, un membre à la fois).
      // Seul le propriétaire peut retirer les siens ; il reste toujours au
      // moins un admin. Un groupe sans plus aucun admin parmi ses membres
      // peut en retrouver un : le membre qui se désigne.
      function isRoleUpdate() {
        let d = request.resource.data;
        let before = adminsOf(resource.data);
        let owner = resource.data.createdBy;
        return resource.data.type == 'group'
          && d.diff(resource.data).affectedKeys().hasOnly(['admins'])
          && d.admins is list
          && d.admins.toSet().size() == d.admins.size()
          && d.admins.size() >= 1
          && resource.data.members.hasAll(d.admins)
          && ((isAdmin(resource.data)
              && ((d.admins.size() == before.size() + 1 && d.admins.hasAll(before))
                || (d.admins.size() == before.size() - 1 && before.hasAll(d.admins)
                  && (!(owner in before.removeAll(d.admins)) || me() == owner))))
            || (isMember(resource.data)
              && !resource.data.members.hasAny(before)
              && d.admins == [me()]));
      }

      allow get: if isMember(resource.data);
      // Seule la requête « mes conversations » (members array-contains moi)
      // passe cette règle.
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && validCreate();
      allow update: if isMember(resource.data)
        && (isPostUpdate() || isReadUpdate() || isTypingUpdate() || isLeaveUpdate()
          || isInfoUpdate() || isPermsUpdate() || isAddUpdate() || isRemoveUpdate()
          || isRoleUpdate());
      allow delete: if false;

      match /messages/{mid} {
        allow read: if isMember(get(/databases/$(database)/documents/conversations/$(cid)).data);
        // Tout nouveau message est chiffré : le texte en clair est refusé.
        allow create: if signedIn()
          && isMember(get(/databases/$(database)/documents/conversations/$(cid)).data)
          && request.resource.data.keys().hasOnly(['uid', 'enc', 'createdAt'])
          && request.resource.data.uid == me()
          && validEnc(request.resource.data.enc,
                      get(/databases/$(database)/documents/conversations/$(cid)).data.members)
          && request.resource.data.createdAt == request.time
          && canPost(get(/databases/$(database)/documents/conversations/$(cid)).data)
          // L'aperçu de la conversation doit pointer sur ce message.
          && getAfter(/databases/$(database)/documents/conversations/$(cid)).data.lastMessage.id == mid;
        allow update, delete: if false;
      }

      // Photo ou message vocal : uniquement des octets chiffrés (e2e.js),
      // créés dans la même écriture que leur message {mid}, par son auteur.
      // Leur clé ne voyage que dans l'enveloppe chiffrée de ce message.
      match /media/{mid} {
        allow read: if isMember(get(/databases/$(database)/documents/conversations/$(cid)).data);
        allow create: if signedIn()
          && isMember(get(/databases/$(database)/documents/conversations/$(cid)).data)
          && request.resource.data.keys().hasOnly(['uid', 'data', 'createdAt'])
          && request.resource.data.uid == me()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() >= 17
          && request.resource.data.data.size() <= 1000000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data.uid == me()
          && getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Membre privé de parole jusqu'à `until` (30 jours au plus), par un
      // admin. Ni le propriétaire ni un admin ne peuvent l'être. Tous les
      // membres voient qui l'est ; un admin peut lui rendre la parole.
      match /restrictions/{uid} {
        function group() {
          return get(/databases/$(database)/documents/conversations/$(cid)).data;
        }

        allow read: if isMember(group());
        allow create, update: if signedIn()
          && group().type == 'group'
          && isAdmin(group())
          && uid in group().members
          && uid != me()
          && uid != group().createdBy
          && !(uid in adminsOf(group()))
          && request.resource.data.keys().hasOnly(['until', 'by', 'at'])
          && request.resource.data.by == me()
          && request.resource.data.at == request.time
          && request.resource.data.until is timestamp
          && request.resource.data.until > request.time
          && request.resource.data.until <= request.time + duration.value(30, 'd');
        allow delete: if signedIn() && group().type == 'group' && isAdmin(group());
      }
    }

    // ------------------------------------------------------------------
    // Appels audio et vidéo (WebRTC), entre les deux membres d'une
    // discussion à deux. Ce document sert seulement à se trouver : offre et
    // réponse SDP, puis candidats ICE. Le son et l'image passent ensuite
    // directement d'un navigateur à l'autre, chiffrés par WebRTC (DTLS-SRTP).
    // ------------------------------------------------------------------
    match /calls/{callId} {

      function isParty(d) {
        return signedIn() && (d.caller == me() || d.callee == me());
      }

      function validSdp(s, type) {
        return s is map
          && s.keys().hasOnly(['type', 'sdp'])
          && s.type == type
          && s.sdp is string && s.sdp.size() >= 1 && s.sdp.size() <= 40000;
      }

      function changes(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // Décrocher : l'appelé, pendant que ça sonne.
      function isAnswer() {
        return me() == resource.data.callee
          && resource.data.status == 'ringing'
          && request.resource.data.status == 'accepted'
          && changes(['status', 'answer', 'answeredAt'])
          && validSdp(request.resource.data.answer, 'answer')
          && request.resource.data.answeredAt == request.time;
      }

      // Refuser (l'appelé) ou renoncer (l'appelant), pendant que ça sonne.
      function isRefusal() {
        return resource.data.status == 'ringing'
          && changes(['status', 'endedAt'])
          && request.resource.data.endedAt == request.time
          && ((me() == resource.data.callee && request.resource.data.status == 'declined')
            || (me() == resource.data.caller && request.resource.data.status == 'missed'));
      }

      // Raccrocher : l'un ou l'autre, pendant l'appel.
      function isHangUp() {
        return resource.data.status == 'accepted'
          && request.resource.data.status == 'ended'
          && changes(['status', 'endedAt', 'endedBy'])
          && request.resource.data.endedBy == me()
          && request.resource.data.endedAt == request.time;
      }

      function validCandidate() {
        let c = request.resource.data;
        return c.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment'])
          && c.candidate is string && c.candidate.size() <= 2000
          && (c.get('sdpMid', null) == null || (c.sdpMid is string && c.sdpMid.size() <= 64))
          && (c.get('sdpMLineIndex', null) == null || c.sdpMLineIndex is int)
          && (c.get('usernameFragment', null) == null
            || (c.usernameFragment is string && c.usernameFragment.size() <= 256));
      }

      allow get: if isParty(resource.data);
      // Seule la requête « les appels qui me sonnent » (callee == moi) passe.
      allow list: if signedIn() && resource.data.callee == me();
      // On n'appelle pas quelqu'un qui nous a bloqués.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['cid', 'caller', 'callee', 'video', 'status', 'offer', 'createdAt'])
        && request.resource.data.caller == me()
        && request.resource.data.callee is string
        && request.resource.data.callee != me()
        && request.resource.data.video is bool
        && request.resource.data.status == 'ringing'
        && validSdp(request.resource.data.offer, 'offer')
        && request.resource.data.createdAt == request.time
        && request.resource.data.cid is string
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.cid)).data.type == 'dm'
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.cid)).data.members
          .hasAll([me(), request.resource.data.callee])
        && !blockedBy(request.resource.data.callee);
      allow update: if isParty(resource.data) && (isAnswer() || isRefusal() || isHangUp());
      allow delete: if false;

      match /callerCandidates/{id} {
        allow read: if isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.caller == me()
          && validCandidate();
        allow update, delete: if false;
      }

      match /calleeCandidates/{id} {
        allow read: if isParty(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callee == me()
          && validCandidate();
        allow update, delete: if false;
      }
    }
  }
}
