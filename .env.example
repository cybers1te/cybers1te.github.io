# Path to Cowrie's JSON Lines log file
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json
# SQLite database path
DATABASE_PATH=./data/cowrie.db
# Flask bind settings
HOST=0.0.0.0
PORT=5000
# Refresh interval used by the browser (seconds)
REFRESH_SECONDS=15
# Optional: set to 1 to seed the database with demo events when the log is absent
DEMO_MODE=0
